<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>__TARGET_FRAMEWORK__</TargetFramework>
    <RootNamespace>AtomUICityApplication</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AtomUICityGenerateManifests>true</AtomUICityGenerateManifests>
    <AtomUICityStrictAot>false</AtomUICityStrictAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AtomUI.City.Build" Version="1.0.0-preview.1" PrivateAssets="all" IncludeAssets="build;buildTransitive;analyzers" />
    <PackageReference Include="AtomUI.City.Core" Version="1.0.0-preview.1" />
    <PackageReference Include="AtomUI.City.Mvvm" Version="1.0.0-preview.1" />
    <PackageReference Include="AtomUI.City.Routing" Version="1.0.0-preview.1" />
    <PackageReference Include="AtomUI.City.Localization" Version="1.0.0-preview.1" />
    <PackageReference Include="AtomUI.City.Presentation" Version="1.0.0-preview.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <Target Name="EnsureAtomUICityBuildIntegration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AtomUICityBuildIntegrationLoaded)' != 'true'" Code="AUCBLD0002" Text="City application projects require AtomUI.City.Build." />
  </Target>

</Project>
