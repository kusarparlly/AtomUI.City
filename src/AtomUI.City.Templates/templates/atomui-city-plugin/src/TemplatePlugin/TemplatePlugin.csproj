<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>__TARGET_FRAMEWORK__</TargetFramework>
    <RootNamespace>TemplatePlugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>TemplatePlugin</PackageId>
    <Version>1.0.0</Version>
    <Authors>Company</Authors>
    <Description>AtomUI.City plugin.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AtomUICityPlugin>true</AtomUICityPlugin>
    <AtomUICityPluginId>__PLUGIN_ID__</AtomUICityPluginId>
    <AtomUICityPluginVersion>1.0.0</AtomUICityPluginVersion>
    <AtomUICityPluginPublisher>Company</AtomUICityPluginPublisher>
    <AtomUICityPluginDisplayNameKey>Plugin.DisplayName</AtomUICityPluginDisplayNameKey>
    <AtomUICityPluginDescriptionKey>Plugin.Description</AtomUICityPluginDescriptionKey>
    <AtomUICityMinHostVersion>1.0.0-preview.1</AtomUICityMinHostVersion>
    <AtomUICityPluginApiVersion>1.0</AtomUICityPluginApiVersion>
    <AtomUICityPluginUnloadable>true</AtomUICityPluginUnloadable>
    <AtomUICityPluginNativeAotCompatible>false</AtomUICityPluginNativeAotCompatible>
    <AtomUICityPluginGenerateManifest>true</AtomUICityPluginGenerateManifest>
    <AtomUICityPluginValidateManifest>true</AtomUICityPluginValidateManifest>
    <AtomUICityPackageAsPlugin>true</AtomUICityPackageAsPlugin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AtomUI.City.Build" Version="1.0.0-preview.1" PrivateAssets="all" />
    <PackageReference Include="AtomUI.City.Core" Version="1.0.0-preview.1" />
    <PackageReference Include="AtomUI.City.PluginSystem" Version="1.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="atomui-city/plugin.json" Pack="true" PackagePath="atomui-city/" />
  </ItemGroup>

</Project>
