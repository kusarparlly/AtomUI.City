<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AtomUICityTargetFrameworks)</TargetFrameworks>
    <AtomUICityGeneratorAnalyzerPath>$(AtomUICityOutputRoot)/bin/$(Configuration)/AtomUI.City.Generators/netstandard2.0/AtomUI.City.Generators.dll</AtomUICityGeneratorAnalyzerPath>
    <AtomUICityGeneratorAnalyzerPdbPath>$(AtomUICityOutputRoot)/bin/$(Configuration)/AtomUI.City.Generators/netstandard2.0/AtomUI.City.Generators.pdb</AtomUICityGeneratorAnalyzerPdbPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AtomUI.City.Generators/AtomUI.City.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive/AtomUI.City.Build.props" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="buildTransitive/AtomUI.City.Build.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="buildTransitive/AtomUI.City.Application.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="buildTransitive/AtomUI.City.Plugin.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="buildTransitive/AtomUI.City.Core.Diagnostics.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="$(AtomUICityGeneratorAnalyzerPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(AtomUICityGeneratorAnalyzerPath)')" />
    <None Include="$(AtomUICityGeneratorAnalyzerPdbPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(AtomUICityGeneratorAnalyzerPdbPath)')" />
  </ItemGroup>

  <Target Name="ValidateAtomUICityBuildPackageInputs" BeforeTargets="Pack">
    <Error Condition="!Exists('$(AtomUICityGeneratorAnalyzerPath)')" Text="AtomUI.City.Build package input is missing: $(AtomUICityGeneratorAnalyzerPath)" />
  </Target>

</Project>
