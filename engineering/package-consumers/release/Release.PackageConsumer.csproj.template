<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AtomUI.City.Build" Version="$(AtomUICityConsumerVersion)" PrivateAssets="all" />
    <PackageReference Include="AtomUI.City.Core" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.EventBus" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.State" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.Mvvm" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.Routing" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.Data" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.Localization" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.Security" Version="$(AtomUICityConsumerVersion)" />
    <PackageReference Include="AtomUI.City.Presentation" Version="$(AtomUICityConsumerVersion)" />
  </ItemGroup>
</Project>
