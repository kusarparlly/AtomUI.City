<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CityLearning.Workbench.Views.MainWindow"
        Title="City Learning Workbench"
        Width="860"
        Height="620"
        MinWidth="620"
        MinHeight="440"
        Background="#F4F6FA">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32">
    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
      <TextBlock Text="个人工作台" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="一个仅使用 City.Core 承载业务服务的 Avalonia 应用"
                 FontSize="14" Opacity="0.65" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,18">
      <TextBox x:Name="TitleInput"
               Grid.Column="0"
               PlaceholderText="输入一个真实任务，例如：阅读 ApplicationHostBuilder.Build"
               KeyDown="OnTitleInputKeyDown" />
      <Button Grid.Column="1" Content="添加任务" Click="OnAddClick" Padding="20,8" />
    </Grid>

    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="8">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,6,10,10">
          <TextBlock Text="任务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="刷新" Click="OnRefreshClick" />
            <Button Content="完成所选" Click="OnCompleteClick" />
          </StackPanel>
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" Margin="8" ColumnSpacing="12">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsCompleted}"
                          IsHitTestVisible="False"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontSize="16" />
                  <TextBlock Text="{Binding CreatedAt, StringFormat='创建于 {0:yyyy-MM-dd HH:mm}'}"
                             FontSize="12" Opacity="0.55" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="4,16,0,0" Opacity="0.7" />
  </Grid>
</Window>
