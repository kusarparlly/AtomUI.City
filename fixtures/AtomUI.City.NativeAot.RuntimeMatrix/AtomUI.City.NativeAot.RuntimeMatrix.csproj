<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AtomUICityDevelopTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="'$(AtomUICityRuntimeMatrixPublishAot)' == 'true'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AtomUI.City.Core/AtomUI.City.Core.csproj" />
    <ProjectReference Include="../../src/AtomUI.City.Localization/AtomUI.City.Localization.csproj" />
    <ProjectReference Include="../../src/AtomUI.City.Mvvm/AtomUI.City.Mvvm.csproj" />
    <ProjectReference Include="../../src/AtomUI.City.Routing/AtomUI.City.Routing.csproj" />
    <ProjectReference Include="../../src/AtomUI.City.Security/AtomUI.City.Security.csproj" />
    <ProjectReference Include="../../src/AtomUI.City.State/AtomUI.City.State.csproj" />
    <ProjectReference Include="../../src/AtomUI.City.Generators/AtomUI.City.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Compile Include="../Shared/ProcessEntryPoint.cs" Link="ProcessEntryPoint.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(AtomUICityRuntimeMatrixPublishAot)' == 'true' And '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Threading.AccessControl" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/Matrix.en-US.locpack.json"
                      LogicalName="AtomUI.City.NativeAot.RuntimeMatrix.Localization.Matrix.en-US.locpack.json" />
    <None Update="Localization/Matrix.fr-FR.locpack.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
