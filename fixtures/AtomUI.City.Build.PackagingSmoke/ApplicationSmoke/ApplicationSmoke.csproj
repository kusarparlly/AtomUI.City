<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestoreSources>$(MSBuildThisFileDirectory)../../../output/NuGet/Debug;https://api.nuget.org/v3/index.json</RestoreSources>
    <AtomUICityPackageApplication>true</AtomUICityPackageApplication>
    <AtomUICityApplicationId>atomui.city.fixture.application</AtomUICityApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AtomUI.City.Build" VersionOverride="1.0.0-preview.1" PrivateAssets="all" IncludeAssets="build;buildTransitive;analyzers" />
    <AtomUICityStaticPlugin Include="Assets/plugin.nupkg" PluginId="atomui.city.fixture.plugin" />
    <AtomUICityResourcePack Include="Assets/resources.zip" PackId="atomui.city.fixture.resources" />
  </ItemGroup>
</Project>
